#version 450
// Integer LCG + xorshift chain: pure ALU, deterministic, no memory pressure.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { uint d[]; };
layout(push_constant) uniform P { uint iters; uint n; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    uint x = i * 2654435761u + 1u;
    for (uint k = 0u; k < p.iters; k++) {
        x = x * 1664525u + 1013904223u;
        x ^= x << 13; x ^= x >> 17; x ^= x << 5;
    }
    d[i] = x;
}
